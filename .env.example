# SQL Server Connection (using existing database)
DB_HOST=localhost
DB_INSTANCE=SQLEXPRESS
DB_PORT=1433
DB_NAME=HRMS
DB_USER=hrms_app
DB_PASSWORD=your_secure_password

# Connection Options
DB_ENCRYPT=false
DB_TRUST_SERVER_CERT=true
DB_POOL_MIN=0
DB_POOL_MAX=10
DB_POOL_IDLE=30000

# Server
PORT=3000
NODE_ENV=development

# JWT Configuration
JWT_SECRET=your_jwt_secret_key
JWT_EXPIRATION=1h
JWT_REFRESH_EXPIRATION=7d
